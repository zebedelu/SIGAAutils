{
  "manifest_version": 3,
  "name": "SIGAA utils",
  "version": "1.1.0",
  "description": "Utilitários para o SIGAA do IFC (sig.ifc.edu.br)",
  "content_scripts": [
    {
      "matches": ["https://sig.ifc.edu.br/*"],
      "css": ["style.css"],
      "js": [
        "dark-mode.js",
        "wallpaper.js",
        "fire.js",
        "notas.js",
        "settings-ui.js",
        "login-auto.js",
        "calendario.js",
        "menu-animacao.js",
        "horario.js",
        "atualizacao.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["horarios/fotos/*", "horarios/index.json"],
      "matches": ["https://sig.ifc.edu.br/*"]
    }
  ]
}