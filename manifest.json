{
  "manifest_version": 3,
  "name": "SIGAA utils",
  "version": "1.3.0",
  "description": "Utilitários para o SIGAA do IFC (sig.ifc.edu.br)",
  "content_scripts": [
    {
      "matches": ["https://sig.ifc.edu.br/*"],
      "css": ["core/style.css"],
      "js": [
        "core/dark-mode.js",
        "core/wallpaper.js",
        "core/fire.js",
        "features/notas.js",
        "core/settings-ui.js",
        "core/login-auto.js",
        "features/calendario.js",
        "features/menu-animacao.js",
        "features/horario.js",
        "features/progresso-ano-letivo.js",
        "features/notas-home.js",
        "core/atualizacao.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/horarios/fotos/*", "content/horarios/index.json"],
      "matches": ["https://sig.ifc.edu.br/*"]
    }
  ]
}