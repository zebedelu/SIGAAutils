{
  "manifest_version": 3,
  "name": "SIGAA utils",
  "version": "1.0.0",
  "description": "Utilitários para o SIGAA do IFC (sig.ifc.edu.br)",
  "content_scripts": [
    {
      "matches": ["https://sig.ifc.edu.br/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}